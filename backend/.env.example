# =====================================================================
# SecureMailAnalyzer — Environment Configuration Example (.env.example)
# =====================================================================
# Copy this file to .env or configure through the Gmail Shield UI.
# NEVER commit real OAuth client secrets or user tokens to git.

# Flask Server Configuration
FLASK_ENV=production
FLASK_PORT=5000
FLASK_HOST=127.0.0.1

# Google Cloud OAuth 2.0 Credentials for Gmail API
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Create or select a project
# 3. Enable the "Gmail API" under APIs & Services > Library
# 4. Configure OAuth Consent Screen (Internal / External Test, Scope: https://www.googleapis.com/auth/gmail.readonly)
# 5. Under Credentials, create "OAuth 2.0 Client ID" (Web Application)
# 6. Add Authorized Redirect URI: http://127.0.0.1:5000/api/gmail/callback
GMAIL_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX_your_client_secret_here
GMAIL_REDIRECT_URI=http://127.0.0.1:5000/api/gmail/callback

# Pre-Download Enforcement Settings
ENFORCEMENT_MODE=STRICT
BLOCK_THRESHOLD=50
CRITICAL_THRESHOLD=75
FAIL_CLOSED=true
